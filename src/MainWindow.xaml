    <Border x:Name="MainGlassBorder" CornerRadius="0" Margin="0" BorderThickness="0">
        <Border.Background>
            <SolidColorBrush Color="#1C1C1C"/>
        </Border.Background>
        <Grid KeyboardNavigation.TabNavigation="None">
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="52"/>
            </Grid.RowDefinitions>

            
            <Image x:Name="UserCustomBackgroundImage"
                   Grid.RowSpan="3"
                   Visibility="Collapsed"
                   IsHitTestVisible="False"
                   Stretch="UniformToFill"
                   Opacity="1"/>

            
            <Grid x:Name="WhiteLightLayer"
                  Grid.RowSpan="3"
                  Panel.ZIndex="-10"
                  IsHitTestVisible="False"
                  ClipToBounds="True">
                
                <Rectangle>
                    <Rectangle.Fill>
                        <RadialGradientBrush Center="0.28, 0.5" GradientOrigin="0.28, 0.5" RadiusX="0.38" RadiusY="4.0">
                            <RadialGradientBrush.RelativeTransform>
                                <RotateTransform Angle="15" CenterX="0.28" CenterY="0.5"/>
                            </RadialGradientBrush.RelativeTransform>
                            <GradientStop Color="#22FFFFFF" Offset="0.0"/>
                            <GradientStop Color="#10FFFFFF" Offset="0.4"/>
                            <GradientStop Color="#03FFFFFF" Offset="0.75"/>
                            <GradientStop Color="#00FFFFFF" Offset="1.0"/>
                        </RadialGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
            </Grid>

            
            <Border x:Name="TitleBarGlassBorder" Grid.Row="0" Panel.ZIndex="1" CornerRadius="0" BorderThickness="0" 
                    Padding="24,0"
                    MouseLeftButtonDown="ChromeDragRegion_MouseLeftButtonDown"
                    Background="Transparent">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="31" Height="31" Margin="0,0,12,0" VerticalAlignment="Center" Background="Transparent">
                            <Image Source="Masterstrap.ico"
                                   Width="31"
                                   Height="31"
                                   Stretch="Uniform"
                                   SnapsToDevicePixels="True"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <Viewbox Grid.Column="0" Height="25" Stretch="Uniform"
                                     HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock Text="Masterstrap"
                                           Foreground="{DynamicResource TextMain}"
                                           FontSize="100" FontWeight="SemiBold"
                                           TextOptions.TextRenderingMode="Auto" RenderOptions.ClearTypeHint="Enabled"/>
                            </Viewbox>
                        </Grid>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,0" VerticalAlignment="Center">
                        <Button x:Name="SupportBtn" Content="Join Discord"
                                Click="SupportBtn_Click"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Background="#00D9FF"
                                Foreground="White"
                                BorderThickness="0"
                                FontSize="11" FontWeight="SemiBold"
                                Padding="14,8" Margin="0,0,10,0" Cursor="Hand"/>
                        <Button Click="Minimize_Click"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Style="{StaticResource ChromeMinimizeButtonStyle}"
                                Margin="0,0,6,0"/>
                        <Button Content="□"
                                Click="MaximizeRestore_Click"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Style="{StaticResource ChromeMinimizeButtonStyle}"
                                Margin="0,0,6,0"
