                                         Style="{StaticResource NoFocusToggleButtonStyle}">▼</ToggleButton>

                            
                            <Popup x:Name="Popup"
                                  Placement="Bottom"
                                  IsOpen="{TemplateBinding IsDropDownOpen}"
                                  AllowsTransparency="True"
                                  Focusable="False"
                                  PopupAnimation="Slide">
                                <Border Background="{DynamicResource ComboPopupBrush}"
