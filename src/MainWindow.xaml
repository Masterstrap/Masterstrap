                                            <DoubleAnimation Storyboard.TargetName="Dot"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                             To="26"
                                                             Duration="0:0:0.15"/>
                                            <ColorAnimation Storyboard.TargetName="ToggleBorder"
                                                            Storyboard.TargetProperty="Background.(SolidColorBrush.Color)"
                                                            To="#00FF7F"
                                                            Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Dot"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                             To="0"
                                                             Duration="0:0:0.15"/>
                                            <ColorAnimation Storyboard.TargetName="ToggleBorder"
                                                            Storyboard.TargetProperty="Background.(SolidColorBrush.Color)"
                                                            To="#6B7280"
                                                            Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

