                                                            <ComboBoxItem Content="1 Thread" Tag="1"/>
                                                            <ComboBoxItem Content="2 Threads" Tag="2"/>
                                                            <ComboBoxItem Content="3 Threads" Tag="3"/>
                                                            <ComboBoxItem Content="4 Threads" Tag="4"/>
                                                            <ComboBoxItem Content="6 Threads" Tag="6"/>
                                                            <ComboBoxItem Content="8 Threads" Tag="8"/>
                                                            <ComboBoxItem Content="12 Threads" Tag="12"/>
                                                            <ComboBoxItem Content="16 Threads" Tag="16"/>
                                                        </ComboBox>
                                                    </Grid>
                                                </Border>

                                                
                                                <Border Background="{DynamicResource GlassPanelBrushBrighter}" CornerRadius="6" Padding="15,12" Margin="0,0,0,10">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                            <TextBlock Text="Enable Hyper-Threading" Foreground="{DynamicResource TextMain}" FontSize="12" FontWeight="SemiBold"/>
                                                            <TextBlock Text="May improve performance on CPUs with hyper-threading." Foreground="{DynamicResource TextMuted}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                        <ToggleButton x:Name="FFSHyperThreadingToggle" Grid.Column="1" Style="{StaticResource StandardToggleButtonStyle}" Checked="FFSettings_Toggle_Changed" Unchecked="FFSettings_Toggle_Changed"/>
                                                    </Grid>
                                                </Border>

                                                
                                                <TextBlock Text="Framerate &amp; Resolution" Foreground="{DynamicResource TextMain}" FontSize="14" FontWeight="SemiBold" Margin="0,15,0,12"/>
                                                
                                                
                                                <Border Background="{DynamicResource GlassPanelBrushBrighter}" CornerRadius="6" Padding="15,12" Margin="0,0,0,10">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                            <TextBlock Text="Roblox Screen Size" Foreground="{DynamicResource TextMain}" FontSize="12" FontWeight="SemiBold"/>
                                                            <TextBlock Text="Customize Roblox window size and resolution." Foreground="{DynamicResource TextMuted}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                        <ComboBox x:Name="FFSRobloxResolutionCombo" Grid.Column="1" Width="120" Height="30" VerticalAlignment="Center" 
                                                                  Style="{StaticResource FastFlagComboBoxStyle}" SelectionChanged="FFSettings_Combo_Changed">
                                                            <ComboBoxItem Content="Default" Tag="Default" IsSelected="True"/>
                                                            <ComboBoxItem Content="3840x2160 (4K)" Tag="3840x2160"/>
                                                            <ComboBoxItem Content="2560x1440 (2K)" Tag="2560x1440"/>
                                                            <ComboBoxItem Content="1920x1080" Tag="1920x1080"/>
                                                            <ComboBoxItem Content="1536x864" Tag="1536x864"/>
                                                            <ComboBoxItem Content="1440x810" Tag="1440x810"/>
                                                            <ComboBoxItem Content="1280x720" Tag="1280x720"/>
                                                            <ComboBoxItem Content="1152x648" Tag="1152x648"/>
                                                            <ComboBoxItem Content="1096x616" Tag="1096x616"/>
                                                            <ComboBoxItem Content="960x540" Tag="960x540"/>
                                                            <ComboBoxItem Content="852x480" Tag="852x480"/>
                                                            <ComboBoxItem Content="768x432" Tag="768x432"/>
                                                            <ComboBoxItem Content="696x392" Tag="696x392"/>
                                                        </ComboBox>
                                                    </Grid>
                                                </Border>
                                                

                                                
                                                <Border Background="{DynamicResource GlassPanelBrushBrighter}" CornerRadius="6" Padding="15,12" Margin="0,0,0,10">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                            <TextBlock Text="Dynamic Resolution Limits" Foreground="{DynamicResource TextMain}" FontSize="12" FontWeight="SemiBold"/>
                                                            <TextBlock Text="Overrides the internal resolution ceiling." Foreground="{DynamicResource TextMuted}" FontSize="10" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                        <ComboBox x:Name="FFSDynamicResCombo" Grid.Column="1" Width="120" Height="30" VerticalAlignment="Center" 
                                                                  Style="{StaticResource FastFlagComboBoxStyle}" SelectionChanged="FFSettings_Combo_Changed">
                                                            <ComboBoxItem Content="Default" Tag="Default" IsSelected="True"/>
                                                            <ComboBoxItem Content="240p" Tag="240p"/>
                                                            <ComboBoxItem Content="360p" Tag="360p"/>
                                                            <ComboBoxItem Content="480p" Tag="480p"/>
                                                            <ComboBoxItem Content="720p" Tag="720p"/>
                                                            <ComboBoxItem Content="1080p" Tag="1080p"/>
                                                            <ComboBoxItem Content="2K" Tag="2K"/>
                                                            <ComboBoxItem Content="4K" Tag="4K"/>
                                                        </ComboBox>
                                                    </Grid>
                                                </Border>
                                                <TextBlock Text="Network &amp; Replication" Foreground="{DynamicResource TextMain}" FontSize="14" FontWeight="SemiBold" Margin="0,15,0,12"/>

                                                
                                                <Border Background="{DynamicResource GlassPanelBrushBrighter}" CornerRadius="6" Padding="15,12" Margin="0,0,0,10">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                            <TextBlock Text="Optimize Bandwidth (Less Lag)" Foreground="{DynamicResource TextMain}" FontSize="12" FontWeight="SemiBold"/>
                                                            <TextBlock Text="Adjusts sender rates to potentially reduce latency." Foreground="{DynamicResource TextMuted}" FontSize="10" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                        <ToggleButton x:Name="FFSLessLagToggle" Grid.Column="1" Style="{StaticResource StandardToggleButtonStyle}" Checked="FFSettings_Toggle_Changed" Unchecked="FFSettings_Toggle_Changed"/>
                                                    </Grid>
                                                </Border>

                                                
                                                <Border Background="{DynamicResource GlassPanelBrushBrighter}" CornerRadius="6" Padding="15,12" Margin="0,0,0,10">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                            <TextBlock Text="No Payload Size Limit" Foreground="{DynamicResource TextMain}" FontSize="12" FontWeight="SemiBold"/>
                                                            <TextBlock Text="Removes limits on network payloads (useful for large scripts/games)." Foreground="{DynamicResource TextMuted}" FontSize="10" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                        <ToggleButton x:Name="FFSNoPayloadLimitToggle" Grid.Column="1" Style="{StaticResource StandardToggleButtonStyle}" Checked="FFSettings_Toggle_Changed" Unchecked="FFSettings_Toggle_Changed"/>
                                                    </Grid>
                                                </Border>
                                                
                                                
                                                <Border Background="{DynamicResource GlassPanelBrushBrighter}" CornerRadius="6" Padding="15,12" Margin="0,0,0,10">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                            <TextBlock Text="Enable Large Replicator" Foreground="{DynamicResource TextMain}" FontSize="12" FontWeight="SemiBold"/>
                                                            <TextBlock Text="Enhances replication chunk sizes." Foreground="{DynamicResource TextMuted}" FontSize="10" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                        <ToggleButton x:Name="FFSLargeReplicatorToggle" Grid.Column="1" Style="{StaticResource StandardToggleButtonStyle}" Checked="FFSettings_Toggle_Changed" Unchecked="FFSettings_Toggle_Changed"/>
                                                    </Grid>
                                                </Border>
                                                
                                                
                                                <Border Background="{DynamicResource GlassPanelBrushBrighter}" CornerRadius="6" Padding="15,12" Margin="0,0,0,10">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                            <TextBlock Text="Faster Packet Processing" Foreground="{DynamicResource TextMain}" FontSize="12" FontWeight="SemiBold"/>
                                                            <TextBlock Text="Forces instant packet processing, can improve hitreg." Foreground="{DynamicResource TextMuted}" FontSize="10" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                        <ToggleButton x:Name="FFSBetterPacketToggle" Grid.Column="1" Style="{StaticResource StandardToggleButtonStyle}" Checked="FFSettings_Toggle_Changed" Unchecked="FFSettings_Toggle_Changed"/>
                                                    </Grid>
                                                </Border>

                                                
                                                <Border Background="{DynamicResource GlassPanelBrushBrighter}" CornerRadius="6" Padding="15,12" Margin="0,0,0,10">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                            <TextBlock Text="Ping Boost (No Proxy)" Foreground="{DynamicResource TextMain}" FontSize="12" FontWeight="SemiBold"/>
                                                            <TextBlock Text="Optimize network I/O, disable Nagle delay, and boost TCP/IP for lowest ping. Works without any proxy” applied when apply or launch." Foreground="{DynamicResource TextMuted}" FontSize="10" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                        <ToggleButton x:Name="FFSPingBoostToggle" Grid.Column="1" Style="{StaticResource StandardToggleButtonStyle}" Checked="FFSettings_Toggle_Changed" Unchecked="FFSettings_Toggle_Changed" ToolTip="Enable native C++ network priority optimization for Roblox"/>
                                                    </Grid>
                                                </Border>

                                                
                                                <Border Background="{DynamicResource GlassPanelBrushBrighter}" CornerRadius="6" Padding="15,12" Margin="0,0,0,10">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                            <TextBlock Text="Active QoS &amp; NIC Gaming Mode" Foreground="{DynamicResource TextMain}" FontSize="12" FontWeight="SemiBold"/>
                                                            <TextBlock Text="Prioritize Roblox network packets using DSCP QoS (DiffServ 46) and disable NIC energy-saving modes for lowest latency." Foreground="{DynamicResource TextMuted}" FontSize="10" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                        <ToggleButton x:Name="FFSDscpQosToggle" Grid.Column="1" Style="{StaticResource StandardToggleButtonStyle}" Checked="FFSettings_Toggle_Changed" Unchecked="FFSettings_Toggle_Changed" ToolTip="Enable native C++ DSCP packet tagging and disable NIC power saving"/>
                                                    </Grid>
                                                </Border>

                                                
                                                <TextBlock Text="Privacy, Telemetry &amp; Misc" Foreground="{DynamicResource TextMain}" FontSize="14" FontWeight="SemiBold" Margin="0,15,0,12"/>

                                                
                                                <Border Background="{DynamicResource GlassPanelBrushBrighter}" CornerRadius="6" Padding="15,12" Margin="0,0,0,10">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                            <TextBlock Text="Disable Roblox Telemetry" Foreground="{DynamicResource TextMain}" FontSize="12" FontWeight="SemiBold"/>
                                                            <TextBlock Text="Blocks Roblox analytics tracking systems." Foreground="{DynamicResource TextMuted}" FontSize="10" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                        <ToggleButton x:Name="FFSDisableTelemetryToggle" Grid.Column="1" Style="{StaticResource StandardToggleButtonStyle}" Checked="FFSettings_Toggle_Changed" Unchecked="FFSettings_Toggle_Changed"/>
                                                    </Grid>
                                                </Border>

                                                
                                                <Border Background="{DynamicResource GlassPanelBrushBrighter}" CornerRadius="6" Padding="15,12" Margin="0,0,0,10">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                            <TextBlock Text="Disable In-Game Ads" Foreground="{DynamicResource TextMain}" FontSize="12" FontWeight="SemiBold"/>
                                                            <TextBlock Text="Disables the AdService API." Foreground="{DynamicResource TextMuted}" FontSize="10" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                        <ToggleButton x:Name="FFSDisableAdsToggle" Grid.Column="1" Style="{StaticResource StandardToggleButtonStyle}" Checked="FFSettings_Toggle_Changed" Unchecked="FFSettings_Toggle_Changed"/>
                                                    </Grid>
                                                </Border>
                                                
                                                
                                                <Border Background="{DynamicResource GlassPanelBrushBrighter}" CornerRadius="6" Padding="15,12" Margin="0,0,0,10">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                            <TextBlock Text="Block Tencent Auth" Foreground="{DynamicResource TextMain}" FontSize="12" FontWeight="SemiBold"/>
                                                            <TextBlock Text="Restricts Tencent verification/policies." Foreground="{DynamicResource TextMuted}" FontSize="10" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                        <ToggleButton x:Name="FFSBlockTencentToggle" Grid.Column="1" Style="{StaticResource StandardToggleButtonStyle}" Checked="FFSettings_Toggle_Changed" Unchecked="FFSettings_Toggle_Changed"/>
                                                    </Grid>
                                                </Border>
                                                
                                                
                                                <Border Background="{DynamicResource GlassPanelBrushBrighter}" CornerRadius="6" Padding="15,12" Margin="0,0,0,10">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                            <TextBlock Text="Disable GUI Blur" Foreground="{DynamicResource TextMain}" FontSize="12" FontWeight="SemiBold"/>
                                                            <TextBlock Text="Disables the CoreGui menu background blur." Foreground="{DynamicResource TextMuted}" FontSize="10" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                        <ToggleButton x:Name="FFSNoGuiBlurToggle" Grid.Column="1" Style="{StaticResource StandardToggleButtonStyle}" Checked="FFSettings_Toggle_Changed" Unchecked="FFSettings_Toggle_Changed"/>
                                                    </Grid>
                                                </Border>
                                                
                                                
                                                <Border Background="{DynamicResource GlassPanelBrushBrighter}" CornerRadius="6" Padding="15,12" Margin="0,0,0,10">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                            <TextBlock Text="Unlimited Camera Zoom" Foreground="{DynamicResource TextMain}" FontSize="12" FontWeight="SemiBold"/>
                                                            <TextBlock Text="Bypasses the maximum camera distance limit." Foreground="{DynamicResource TextMuted}" FontSize="10" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                        <ToggleButton x:Name="FFSUnlimitedZoomToggle" Grid.Column="1" Style="{StaticResource StandardToggleButtonStyle}" Checked="FFSettings_Toggle_Changed" Unchecked="FFSettings_Toggle_Changed"/>
                                                    </Grid>
                                                </Border>

                                                
                                                <Border Background="{DynamicResource GlassPanelBrushBrighter}" CornerRadius="6" Padding="15,12" Margin="0,0,0,10">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,15,0">
                                                            <TextBlock Text="Custom Disconnect Message" Foreground="{DynamicResource TextMain}" FontSize="12" FontWeight="SemiBold"/>
                                                            <TextBlock Text="Set a custom message when disconnected." Foreground="{DynamicResource TextMuted}" FontSize="10" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBox x:Name="FFSCustomDisconnectText" Width="150" Height="28" Padding="5,0" VerticalContentAlignment="Center"
                                                                     Background="{DynamicResource InputFieldBgBrush}" Foreground="{DynamicResource TextMain}" BorderThickness="1" BorderBrush="{DynamicResource BorderColor}"
                                                                     Margin="0,0,10,0" Text="Disconnected by Masterstrap" TextChanged="FFSettings_Text_Changed"/>
                                                            <ToggleButton x:Name="FFSCustomDisconnectToggle" Style="{StaticResource StandardToggleButtonStyle}" Checked="FFSettings_Toggle_Changed" Unchecked="FFSettings_Toggle_Changed"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>

                                            </StackPanel>
                                        </ScrollViewer>
                                    </Grid>
                                </Border>
                            </TabItem>
                        </TabControl>
                </Border>
            </Grid>

            
            <Border x:Name="FooterGlassBorder" Grid.Row="2" CornerRadius="0" BorderThickness="0"
                    Padding="20,8"
                    MouseLeftButtonDown="ChromeDragRegion_MouseLeftButtonDown"
                    Background="Transparent">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{DynamicResource GlassPanelBrushBrighter}" CornerRadius="4" Padding="10,6"
                                BorderThickness="0" Margin="0,0,16,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Fast Mode" Foreground="{DynamicResource TextMain}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"
                                           TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"/>
                                <ToggleButton x:Name="FastModeToggle" Width="40" Height="20"
                                              Cursor="Hand" VerticalAlignment="Center"
                                              shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                              ToolTip="Fast Mode will limit some crash-prone flags for low-end PCs."
                                              Checked="FastModeToggle_Checked" Unchecked="FastModeToggle_Unchecked">
                                    <ToggleButton.Template>
                                        
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="ToggleBorder" Background="#6B7280" CornerRadius="10" Width="40" Height="20"
                                                    BorderThickness="0">
                                                <Ellipse x:Name="Dot" Fill="White" Width="14" Height="14"
                                                         HorizontalAlignment="Left" Margin="3,0,0,0"
                                                         VerticalAlignment="Center">
                                                    <Ellipse.RenderTransform>
                                                        <TranslateTransform X="0"/>
                                                    </Ellipse.RenderTransform>
                                                </Ellipse>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="ToggleBorder" Property="Background" Value="#00FF7F"/>
                                                    <Setter TargetName="Dot" Property="RenderTransform">
                                                        <Setter.Value>
                                                            <TranslateTransform X="20"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                            </StackPanel>
                        </Border>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="StatusDot" Width="10" Height="10" 
                                     Fill="{DynamicResource Success}" Margin="0,0,8,0"/>
                            <StackPanel Orientation="Vertical">
                                <TextBlock x:Name="StatusText" Text="Ready" 
                                           Foreground="{DynamicResource TextMain}" 
                                           FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock x:Name="ProgressText" Text="0% • Idle" 
                                           Foreground="{DynamicResource TextMuted}" 
                                           FontSize="10" Margin="0,1,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" 
                                HorizontalAlignment="Center" Margin="20,0"/>

                    
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,0">
                        
                        <Grid Margin="0,0,10,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <Button x:Name="OpenRobloxBtn" Content="Save and Launch" 
                                    Click="OpenRobloxBtn_Click"
                                    shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                    Style="{StaticResource FooterNeonGreenCtaLeftButton}"
                                    Grid.Column="0"/>
                                    
                            <ToggleButton x:Name="AccountDropdownBtn" Content="▼" 
                                          Style="{StaticResource FooterNeonGreenCtaRightButton}"
                                          shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                          Grid.Column="1"
                                          Height="{Binding ActualHeight, ElementName=OpenRobloxBtn}"
                                          Checked="AccountDropdownBtn_Checked"/>
                                          
                            <Popup x:Name="AccountPopup" PlacementTarget="{Binding ElementName=AccountDropdownBtn}" Placement="Top" VerticalOffset="-4" StaysOpen="False" AllowsTransparency="True" IsOpen="{Binding IsChecked, ElementName=AccountDropdownBtn}">
                                <Border Background="{DynamicResource GlassPanelBrushBrighter}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="5" Padding="5" MinWidth="150" Margin="0,0,0,4">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.5"/>
                                    </Border.Effect>
                                    <StackPanel x:Name="AccountListPanel">
                                        
                                        
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>

                        
                        <Button x:Name="SaveBtn" Content="Save" 
                                Click="SaveBtn_Click"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Style="{StaticResource FooterNeonGreenCtaButton}"
                                Margin="0,0,10,0"/>

                        
                        <Button x:Name="CloseBtn" Content="Close" 
                                Click="CloseBtn_Click"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Style="{StaticResource FooterCloseButtonStyle}"
                                VerticalAlignment="Center">
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            
            <ItemsControl x:Name="ToastNotificationsPanel" 
                         Grid.Row="0" Grid.RowSpan="3"
                         VerticalAlignment="Bottom" HorizontalAlignment="Center"
                         Margin="0,0,0,30"
                         IsTabStop="False"
                         Panel.ZIndex="1000">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical" VerticalAlignment="Bottom"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </Grid>
    </Border>
</Window>

